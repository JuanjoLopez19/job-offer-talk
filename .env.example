ENVIRONMENT=DEV
VERSION=0.0.1

# Frontend: enable the static GitHub Pages behavior during its build.
VITE_BASE_PATH=/
VITE_GITHUB_PAGES=false
VITE_GITHUB_REPOSITORY_URL=https://github.com/JuanjoLopez19/job-offer-talk

REDIS__URL=redis://localhost:6379/0

STT__MODEL_NAME=medium
STT__DEVICE=cpu
TTS__VOICE=em_alex
TTS__DEVICE=cpu

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACE_NAME=job-offer-talk

# Create a key restricted to the Gemini API (generativelanguage.googleapis.com).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.7-flash
